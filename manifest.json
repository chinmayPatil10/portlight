{
  "manifest_version": 3,
  "name": "Portlight: AI asset tracker",
  "short_name": "Portlight",
  "version": "1.2.0",
  "description": "Track stocks, ETFs, forex and crypto in Chrome's side panel, with an AI daily brief, risk check, plain-language alerts and portfolio chat.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://api.coingecko.com/*",
    "https://open.er-api.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Portlight",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
